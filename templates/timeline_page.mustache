{{!
    @template block_smartsection_control/timeline_page

    Timeline page: chronological roadmap of scheduled section releases.

    Context variables required for this template:
    * tabs - tab descriptors consumed by the nav_tabs partial (see that template)
    * title - localised page heading
    * description - localised page description
    * legend - array of legend entries with dotclass and label
    * hasnodes - true when at least one scheduled release exists
    * emptymessage - localised empty-state message
    * nodes - array of roadmap entries
      * statusclass - roadmap node state class
      * statusmodifier - status pill modifier class
      * statuslabel - localised status label
      * name - preformatted section name (already passed through format_string)
      * metaline - plain-text meta line, escaped by this template

    Example context (json):
    {
        "title": "Timeline",
        "description": "Review upcoming and completed section releases.",
        "legend": [{"dotclass": "ssc-status-unlocked", "label": "Available"}],
        "hasnodes": true,
        "emptymessage": "No scheduled releases yet.",
        "nodes": [
            {
                "statusclass": "scheduled",
                "statusmodifier": "ssc-status--scheduled",
                "statuslabel": "Scheduled",
                "name": "Week 1",
                "metaline": "1 October 2026 - Fixed date - Hard lock"
            }
        ]
    }

    @package    block_smartsection_control
    @copyright  2026 M. AFZAL RIAZ
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<div class="ssc-page ssc-timeline ssc-ui">

    {{> block_smartsection_control/nav_tabs }}

    <div class="ssc-surface ssc-surface--primary ssc-manager ssc-timeline-surface">
        <div class="ssc-surface-header ssc-manager-header">
            <h2 class="ssc-surface-title ssc-manager-title">{{title}}</h2>
            <p class="ssc-surface-desc ssc-manager-desc">{{description}}</p>
        </div>

        <div class="ssc-timeline-legend" role="note">
            {{#legend}}
            <span class="ssc-legend-item">
                <span class="ssc-status-dot {{dotclass}}" aria-hidden="true"></span>
                <span class="ssc-legend-label">{{label}}</span>
            </span>
            {{/legend}}
        </div>

        {{#hasnodes}}
        <div class="ssc-roadmap" role="list">
            {{#nodes}}
            <div class="ssc-roadmap-node {{statusclass}}" role="listitem">
                <div class="ssc-roadmap-marker" aria-hidden="true"></div>
                <div class="ssc-roadmap-content">
                    <div class="ssc-roadmap-main">
                        <h3 class="ssc-roadmap-title">{{{name}}}</h3>
                        <p class="ssc-roadmap-meta">{{metaline}}</p>
                    </div>
                    <span class="ssc-status {{statusmodifier}}">{{statuslabel}}</span>
                </div>
            </div>
            {{/nodes}}
        </div>
        {{/hasnodes}}

        {{^hasnodes}}
        <div class="ssc-empty ssc-timeline-empty" role="status">
            <div class="ssc-empty-icon">{{#pix}}i/calendar, core{{/pix}}</div>
            <p class="ssc-empty-title">{{emptymessage}}</p>
        </div>
        {{/hasnodes}}
    </div>
</div>
