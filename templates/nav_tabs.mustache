{{!
    @template block_smartsection_control/nav_tabs

    Tab navigation shared by the Manage, Timeline and Audit history pages.

    Context variables required for this template:
    * tabs - array of tab descriptors
      * url - target page URL
      * label - already localised tab label
      * active - true when the tab represents the current page

    Example context (json):
    {
        "tabs": [
            {"url": "https://example.com/manage.php?id=2", "label": "Manage", "active": true},
            {"url": "https://example.com/timeline.php?id=2", "label": "Timeline", "active": false}
        ]
    }

    @package    block_smartsection_control
    @copyright  2026 M. AFZAL RIAZ
    @license    https://www.gnu.org/copyleft/gpl.html GNU GPL v3 or later
}}
<ul class="nav nav-tabs ssc-nav-tabs" role="tablist">
    {{#tabs}}
    <li class="nav-item">
        <a href="{{url}}" class="nav-link{{#active}} active{{/active}}"{{#active}} aria-current="page"{{/active}}>{{label}}</a>
    </li>
    {{/tabs}}
</ul>
